# OpenRouter API Key: Used to route AI chat requests via OpenRouter to Gemini Flash.
# You can get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"

# GEMINI_API_KEY: Fallback or direct Gemini AI API key.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="https://ordoaxio.vercel.app"

# Telegram Bot Token for Lead notifications
TELEGRAM_BOT_TOKEN=""